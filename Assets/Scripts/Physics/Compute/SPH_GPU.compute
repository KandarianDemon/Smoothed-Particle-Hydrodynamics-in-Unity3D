}

[numthreads(GROUP_SIZE,1,1)]
void Update(uint3 id: SV_DispatchThreadID)
{
    if(_STATIC[id.x] == 1) return;
    // ***************** Set Up Position, Velocity, Forces **********************
    float timestep = 0.001f;

    float3 position = POSITIONS[id.x];
    float3 velocity = VELOCITIES[id.x];

    // ********************** Choose Integrator *********************************

    float3 pressureForce = FORCES[id.x]*timestep;
    // ***************** Integrate Position and Velocity ************************

    for(int i = 0; i<10;i++)
    {
        SemiImplicitEuler(position,velocity,pressureForce,timestep);
    }
    // ***************** Resolve Membrane Collisions ****************************


    // float travelDistance    = length(position - POSITIONS[id.x]);
    // Ray ray                 = ConstructRay(position,normalize(velocity),travelDistance);
    // HitInfo info            = GetHitInfo();

    //bool hit                = BruteForceCollisions(id,)
    // ***************** Resolve Domain Collisions ******************************

     ResolveCollisions(position,velocity,POSITIONS,VELOCITIES,id.x);
    // *********************** Debug Stuff **************************************


}


