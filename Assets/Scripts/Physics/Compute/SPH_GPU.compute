#pragma target 5.0

#pragma kernel InitParticles    //<<::POSITIONS::VELOCITIES::DENSITIES::REFDENSITIES::_STATIC::TYPES::COLORS::MASSES::>>

// **** Neighbor Hood Search ******
// Assigning a hash value to each particle to sort into a grid array. PArticles are sorted and mapped by grid location.
#pragma kernel ClearGrid        //<<::CELLCOUNT::CELLTRACKER::>>
#pragma kernel GridUpdate       //<<::HASHES::PREDICTEDPOSITIONS::POSITIONS::CELLCOUNT::>>
#pragma kernel PartialSums      //<<::CELLCOUNT::>>
#pragma kernel MapParticles     //<<::PARTICLEMAP::HASHES::CELLCOUNT::CELLTRACKER::INDICES::>>

// ****** Physics *****************
// Implementation of standard SPH procedure.
// Forces computation can include boundary forces
#pragma kernel ComputeDensity //<::POSITIONS::PREDICTEDPOSITIONS::CELLCOUNT::CELLTRACKER::PARTICLEMAP::DENSITIES::REFDENSITIES::PRESSURES::>>
#pragma kernel ComputeForces // <::POSITIONS::PREDICTEDPOSITIONS::CELLCOUNT::CELLTRACKER::PARTICLEMAP::FORCES::PRESSURES::>>
#pragma kernel ConstraintSolver

// ****** Integration *************
#pragma kernel Update //<::POSITIONS::VELOCITIES::FORCES::>>




// ********* SPH Related Functions *******
#include "./Include/SPH/SPHkernels.cginc"
#include "./Include/SPH/SPHUtility.hlsl"
#include "./Include/SPH/structs.cginc"
#include "./Include/SPH/sph_settings.cginc"
#include "./Include/SPH/sph_gpu_buffers.cginc"
