//********** Collision Detection *********
#include "./Include/CollisionDetection/collisions_detection.hlsl"
#include "./Include/CollisionDetection/boundary_handling.cginc"
#include "./Include/CollisionDetection/BVH.cginc"

//********* MAths and Physics functions *************
#include "./Include/Math/integrators.cginc"
#include "./Include/Math/constraints.hlsl"
#include "./Include/Math/FluidMaths.hlsl"

#define MAX_NEIGHBORS 80
#define GROUP_SIZE 512
#define USE_SOA


[numthreads(GROUP_SIZE,1,1)]
void InitParticles(uint3 id: SV_DispatchThreadID)
{

    // Initializes Particles in given Locations
    // Placement of particles -> Volume mesh. Place in grid, or random. Volume should be conserved tho.

    // Places particles in relation to the simulation space.

    if(_STATIC[id.x] == 1)
    {
        COLORS[id.x]        = float3(0,1,0);
        VELOCITIES[id.x]    = -GRAVITY*0.5f;
        TYPES[id.x]         = 1;
        return;
    }

    int3 dimensions = GetDimensions(float3(1,1,1),PARTICLE_RADIUS/2.0f);

    int x = floor(id.x/(dimensions.y*dimensions.x));
    int y = floor((id.x/dimensions.y) % dimensions.z);
    int z =  floor(id.x % dimensions.z);

    DENSITIES[id.x]         = 1000;
    REFDENSITIES[id.x]      = 1000;
    MASSES[id.x]            = ((4*pow(PARTICLE_RADIUS,3)*PI)/(NUMBER_OF_PARTICLES*3))*DENSITIES[id.x];
    _STATIC[id.x]           = 0;

    POSITIONS[id.x]         = float3(x,y,z)*PARTICLE_RADIUS*2.0f - HALF_BOUNDSIZE;

}

[numthreads(GROUP_SIZE,1,1)]
void ClearGrid(uint3 id: SV_DispatchThreadID)
{

    // Clears the Grid for neighbor computation

    CELLCOUNT[id.x] = 0;
    CELLTRACKER[id.x] = 0;

}

[numthreads(GROUP_SIZE,1,1)]
void GridUpdate(uint3 id: SV_DispatchThreadID)
{
    // Updates the grid and assigns particles to a grid id via Hashing.

    if(id.x >= NUMBER_OF_PARTICLES) return;

    int idCell = GetCellHash(POSITIONS[id.x],HALF_BOUNDSIZE,SMOOTHING_RADIUS,NUMBEROFCELLS);  // Returns Hash of the current grid Cell
    InterlockedAdd(CELLCOUNT[idCell],1u);                                                              // Increments the count of cells in current grid cell
    HASHES[id.x] = idCell;                                                                     // Stores current grid ID on the particle
    PREDICTEDPOSITIONS[id.x] = POSITIONS[id.x] + GRAVITY * 1/120.0f;                 // predicts future position on basis of external forces only.

   


    

}

[numthreads(GROUP_SIZE,1,1)]
void PartialSums(uint3 id: SV_DispatchThreadID)
{

    // Loops over all the cells and writes the partial sums in the non occupied cells. So occupied cells in 
    // a sparse grid can be found

    if(id.x >= NUMBEROFCELLS) return;

    int partialSum = 0;

    if(id.x == 0) {
        partialSum = CELLCOUNT[id.x];
    }
    else{

        for(int i = 0; i<= id.x;i++)
        {
            partialSum += CELLCOUNT[id.x];          // 00000111111111112222222444444444 
        }
    }

    CELLCOUNT[id.x] = partialSum;
}

[numthreads(GROUP_SIZE,1,1)]
void MapParticles(uint3 id: SV_DispatchThreadID)
{

    // Orders the particles in a "ParticleMap"- buffer, so they can be accessed by the neighborhood search
    if(id.x >= NUMBER_OF_PARTICLES) return;
    
    int idCell = HASHES[id.x];
    int index = 0;

    InterlockedAdd(CELLTRACKER[idCell],1,index);

    int startIndex = CELLCOUNT[idCell] - index;   // new index of the particle in the sorted particle map
    INDICES[id.x] = startIndex;       // Store the index on the particle

    PARTICLEMAP[startIndex] = id.x;           // store id of the particle in the sorted array
    

}

[numthreads(GROUP_SIZE,1,1)]
void ComputeDensity(uint3 id: SV_DispatchThreadID)
{

   

    if(id.x >= NUMBER_OF_PARTICLES) return;


    // ************ Identify indices of the neighboring 27 cells.*******************

            // :: Get CurrentPosition
            float3 position = POSITIONS[id.x];
            int3 dimensions = GetDimensions(HALF_BOUNDSIZE*2.0f,SMOOTHING_RADIUS);
            int indices [27];
            NeighborIndexData nIndices = GetNeighborCellIndices(position,dimensions,SMOOTHING_RADIUS,NUMBEROFCELLS).indices;
            indices = nIndices.indices;
            float sum = 0;   // sum of densities;
            // :: Interpolate neighbor cells
            // :: Retrieve CellIndex in that position.

            // :: Could also work with BVH Nodes and flattened BVHNode array.

            // return int[27] array of Indices.




    // ************ Access Neighbor Particles **********************************
    // Loop over the neighbor Cells and check the particles contained within them.

    for(int j = 0; j<27;j++)
    {
        int nCell = indices[j];
        if(nCell <0) continue;

        int start = max(0,CELLCOUNT[nCell] - CELLTRACKER[nCell]);  // Find startindex in particle map
        int lim   = min(CELLTRACKER[nCell],MAX_NEIGHBORS);         // Define when to abort the loop

        float3 position = PREDICTEDPOSITIONS[id.x];

        for(int i = start; i<start+lim;i++)
        {
            int pIDX = PARTICLEMAP[i];    // Gets the index of the particle at location i of the particle Map
            if(_STATIC[pIDX] == 1) continue;


            float3 dir = position - PREDICTEDPOSITIONS[pIDX];
            float dist = sqrt(dot(dir,dir));
            if(dist > SMOOTHING_RADIUS) continue;

            sum += WPoly6Kernel(dist,SMOOTHING_RADIUS,PI);



            
        }
    }

    // Once density has been estimated. Estimate PRessure
    DENSITIES[id.x] = sum + 0.00001f;
    PRESSURES[id.x] = max(STIFFNESS*(DENSITIES[id.x] - REFDENSITIES[id.x]),0);

    // Apply Smoothing Kernel and compute density;




}

[numthreads(GROUP_SIZE,1,1)]
void ComputeForces(uint3 id: SV_DispatchThreadID)
{
        if(id.x > NUMBER_OF_PARTICLES) return;

    float3 position = NormalizePosition(POSITIONS[id.x],HALF_BOUNDSIZE);
    float3 pressureForce = float3(0,0,0);
    float3 viscosityForce = float3(0,0,0);

   // *************** Identify indices of the neighboring 27 cells ****************
   int3 dimensions = GetDimensions(HALF_BOUNDSIZE*2,SMOOTHING_RADIUS);
   int indices[27];
   NeighborIndexData nIndices = GetNeighborCellIndices(position,dimensions,SMOOTHING_RADIUS,NUMBEROFCELLS).indices;
   indices = nIndices.indices;

   // *************** Access Neighbor Particles ***********************************
   for(int j = 0;j<27;j++)
   {

        int nCell = indices[j];
        if(nCell < 0) continue;

        int start = max(0,CELLCOUNT[nCell] - CELLTRACKER[nCell]);  // gets start index in particleMap
        int lim   = min(CELLTRACKER[nCell],MAX_NEIGHBORS);        // sets exit condition;

        for(int i = start; i< start + lim; i++)
        {
            int pIDX = PARTICLEMAP[i];
            if(_STATIC[pIDX] == 1) continue;

            float3 dir  = PREDICTEDPOSITIONS[id.x] - PREDICTEDPOSITIONS[pIDX];
            float  dist = sqrt(dot(dir,dir));
           


            if(dist > SMOOTHING_RADIUS) continue;

            float3 dirNormalized = normalize(dir);
            float pressureMean = (PRESSURES[id.x] + PRESSURES[pIDX])/2.0f;

            pressureForce   += MASSES[pIDX]/DENSITIES[pIDX] * pressureMean + SpikeyKernelFirstDerivative(dist,SMOOTHING_RADIUS,PI);
            viscosityForce  += (VELOCITIES[pIDX] - VELOCITIES[id.x])*ViscosityKernelLaplacian(dist,SMOOTHING_RADIUS);



        }


   }


   // ************** Do Stuff with the Particles **********************************
   // ___ Add boundary repulsion forces here___

    FORCES[id.x] = -(pressureForce/DENSITIES[id.x]) + VISCOSITY * viscosityForce;


}

